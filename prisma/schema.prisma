datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  CONTENT_ADMIN
  HR
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CONTENT_ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyProfile {
  id                 String   @id @default("default")
  companyName        String   @default("PT Artha Konstruksi Indonesia")
  slogan             String   @default("Membangun Masa Depan dengan Presisi & Integritas")
  description        String
  address            String
  phone              String
  whatsapp           String
  email              String
  mapsEmbedUrl       String?
  experienceYears    Int      @default(15)
  completedProjects  Int      @default(120)
  professionalStaff  Int      @default(50)
  corporateClients   Int      @default(25)
  linkedin           String?
  instagram          String?
  facebook           String?
  youtube            String?
  updatedAt          DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String   // Construction, Engineering, Project Management
  description String
  icon        String?  // lucide icon identifier
  scopeOfWork String   // JSON string or newline separated
  thumbnail   String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  client      String
  location    String
  year        Int
  value       String?        // e.g. "Rp 45 Miliar" or "Confidential"
  category    String         // Building Construction, Industrial, Infrastructure, Engineering, etc.
  description String
  scopeOfWork String         // newline separated or detailed text
  status      String         @default("Completed") // Completed, Ongoing
  featured    Boolean        @default(false)
  thumbnail   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  gallery     ProjectImage[]
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Certification {
  id                String    @id @default(cuid())
  title             String
  issuer            String
  certificateNumber String?
  category          String    // ISO, K3 / SMK3, Legalitas, Penghargaan
  year              Int
  validUntil        DateTime?
  fileUrl           String?   // PDF or image doc
  thumbnail         String?
  order             Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ClientPartner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String
  industry  String?
  featured  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String   // Company News, Project Updates, CSR, Events, Achievement
  excerpt     String
  content     String
  thumbnail   String
  author      String   @default("Tim Komunikasi Korporat")
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
  seoKeywords String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Career {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  department   String
  location     String
  type         String      @default("Full-time") // Full-time, Contract, Internship
  description  String
  requirements String      // newline separated or text
  deadline     DateTime?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  applicants   Applicant[]
}

model Applicant {
  id           String   @id @default(cuid())
  careerId     String
  career       Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  fullName     String
  email        String
  phone        String
  cvFileUrl    String
  portfolioUrl String?
  notes        String?
  status       String   @default("Applied") // Applied, Screening, Interview, Offered, Rejected
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Inquiry {
  id            String   @id @default(cuid())
  name          String
  company       String?
  email         String
  phone         String
  subject       String
  message       String
  status        String   @default("New") // New, In_Progress, Contacted, Closed
  internalNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
